# Copy to .env for local development. Never put real secrets in Git.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgres://greenwood:greenwood@localhost:5432/greenwood
SESSION_SECRET=replace-with-a-long-random-string
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-one-time-bootstrap-token
CLASSROOM_MODE=true
PUBLIC_REGISTRATION=false
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=info
WORLD_VERSION=dev
RAW_COMMAND_RETENTION_DAYS=14
CHAT_RETENTION_DAYS=30
