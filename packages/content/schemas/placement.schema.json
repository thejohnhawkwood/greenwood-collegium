{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenwood.local/schemas/placement.json",
  "title": "Greenwood item placement",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "templateId", "roomId"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "templateId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "roomId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "starterPerCharacter": {
      "type": "boolean",
      "description": "Do not seed one shared instance. Each Collegian receives a personal copy on first look or take."
    }
  }
}
