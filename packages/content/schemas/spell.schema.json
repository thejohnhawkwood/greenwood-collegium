{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenwood.local/schemas/spell.json",
  "title": "Greenwood spell template",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "school",
    "description",
    "focusCost",
    "targetType",
    "context",
    "presentationKey",
    "helpText"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "school": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "focusCost": {
      "type": "integer",
      "minimum": 0
    },
    "targetType": {
      "enum": ["enemy", "self"]
    },
    "context": {
      "enum": ["encounter", "any"]
    },
    "damage": {
      "type": "integer",
      "minimum": 0
    },
    "effect": {
      "enum": [
        "skip-counter",
        "avoid-hit",
        "heal",
        "brace",
        "ready-strike",
        "riposte",
        "insight",
        "restore-focus",
        "halve-hit",
        "weaken",
        "ready-spell",
        "leech"
      ]
    },
    "heal": {
      "type": "integer",
      "minimum": 1
    },
    "insight": {
      "type": "string",
      "minLength": 1
    },
    "burningRounds": {
      "type": "integer",
      "minimum": 1
    },
    "burningDamage": {
      "type": "integer",
      "minimum": 1
    },
    "restoreFocus": {
      "type": "integer",
      "minimum": 1
    },
    "readySpellIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "minLevel": {
      "type": "integer",
      "minimum": 1
    },
    "tag": {
      "enum": ["strike", "control", "ward", "gift"]
    },
    "pennedBy": {
      "type": "string",
      "minLength": 1
    },
    "ranks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "focusCost": { "type": "integer", "minimum": 0 },
          "damage": { "type": "integer", "minimum": 0 },
          "heal": { "type": "integer", "minimum": 1 },
          "burningRounds": { "type": "integer", "minimum": 1 },
          "burningDamage": { "type": "integer", "minimum": 1 },
          "restoreFocus": { "type": "integer", "minimum": 1 },
          "insight": { "type": "string", "minLength": 1 },
          "marginNote": { "type": "string", "minLength": 1 }
        }
      }
    },
    "presentationKey": {
      "type": "string",
      "minLength": 1
    },
    "helpText": {
      "type": "string",
      "minLength": 1
    }
  }
}
