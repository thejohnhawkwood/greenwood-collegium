{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenwood.local/schemas/spell.json",
  "title": "Greenwood spell template",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "school",
    "description",
    "focusCost",
    "targetType",
    "context",
    "damage",
    "burningRounds",
    "burningDamage",
    "presentationKey",
    "helpText"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "school": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "focusCost": {
      "type": "integer",
      "minimum": 0
    },
    "targetType": {
      "const": "enemy"
    },
    "context": {
      "const": "encounter"
    },
    "damage": {
      "type": "integer",
      "minimum": 1
    },
    "burningRounds": {
      "type": "integer",
      "minimum": 1
    },
    "burningDamage": {
      "type": "integer",
      "minimum": 1
    },
    "presentationKey": {
      "type": "string",
      "minLength": 1
    },
    "helpText": {
      "type": "string",
      "minLength": 1
    }
  }
}
