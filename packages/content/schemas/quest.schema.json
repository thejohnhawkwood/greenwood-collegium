{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenwood.local/schemas/quest.json",
  "title": "Greenwood quest template",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "introNarration",
    "reminderNarration",
    "experienceReward",
    "objectives"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "introNarration": {
      "type": "string",
      "minLength": 1
    },
    "reminderNarration": {
      "type": "string",
      "minLength": 1
    },
    "experienceReward": {
      "type": "integer",
      "minimum": 1
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "label"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "kind": {
            "enum": ["look", "say", "take", "visit", "examine", "talk"]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "itemTemplateId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "roomId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "targetId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "requires": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": ["examine", "talk"]
                }
              }
            },
            "then": {
              "required": ["targetId"]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "take"
                }
              }
            },
            "then": {
              "required": ["itemTemplateId"]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "visit"
                }
              }
            },
            "then": {
              "required": ["roomId"]
            }
          }
        ]
      }
    },
    "giverNpcId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "completionNarration": {
      "type": "string",
      "minLength": 1
    }
  }
}
